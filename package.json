{
  "name": "envclarity",
  "version": "0.1.0",
  "private": true,
  "description": "Auditor local de variables de entorno para proyectos TypeScript, Node y React.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm build && node --test test/*.test.ts"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^24.17.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  }
}
